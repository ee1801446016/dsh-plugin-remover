{
  "name": "dsh-plugin-remover",
  "version": "1.4.0",
  "description": "在会话菜单里删除一个对话，并按需带走它产出的文件、会话期间变更的文件、子代理对话与附件，也可以只删文件留下对话；读过的文件只列出、不删除。同一份内容只出现一次，对话框分区折叠一屏看全，删除先进回收站，可整组/单文件/批量恢复并回到原工作区。· Delete a conversation together with what it produced, keep the conversation and delete only its files, and restore either from a restorable recycle bin. Files it merely read are listed, never deleted.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "verify",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "verify": "node verify/verify-host.mjs",
    "verify:client": "node verify/verify-client.cjs",
    "verify:render": "node verify/verify-render.mjs",
    "verify:routes": "node verify/verify-routes-120.mjs",
    "verify:runtime": "node verify/verify-runtime.mjs",
    "verify:scan": "node verify/verify-scan.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "session",
    "conversation",
    "delete",
    "remove",
    "trash",
    "recycle-bin",
    "restore",
    "cleanup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ee1801446016/dsh-plugin-remover.git"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
